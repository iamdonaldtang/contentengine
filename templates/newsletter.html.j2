{# TaskOn Newsletter HTML template (B1 §2 Newsletter section).

   Required context vars:
     subject:        Email subject line (also used as <title>)
     intro:          Section 1 — 头条 ≤ 300 chars (HTML or plain text)
     case_study:     Section 2 — 案例 ≤ 200 chars
     radar:          Section 3 — 雷达 ≤ 300 chars
     cta:            Section 4 — CTA ≤ 100 chars
     cta_url:        Click-through URL on the primary button
     unsubscribe_url:Listmonk auto-fills {{UnsubscribeURL}}; provide a fallback here
     send_date_str:  Human-readable date in the header (e.g. "2026-05-29")
     palette:        Optional dict with hex strings: primary, accent, text, bg
                     Defaults match TaskOn brand from 01_品牌图片.

   Listmonk recognises ``{{ .Subscriber }}``-style placeholders ONLY if it
   processes them server-side after template render. The Jinja render here
   produces FINAL HTML — Listmonk will only swap ``{{UnsubscribeURL}}``
   etc. since we leave those raw via {% raw %} blocks.
#}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>{{ subject | e }}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: {{ palette.bg | default('#F4F5F7') }};
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      color: {{ palette.text | default('#1A1A1A') }};
      line-height: 1.6;
    }
    .container {
      max-width: 640px;
      margin: 0 auto;
      background: #FFFFFF;
      padding: 32px 24px;
    }
    h1 { font-size: 22px; margin: 0 0 12px; color: {{ palette.primary | default('#0F172A') }}; }
    h2 { font-size: 17px; margin: 28px 0 10px; color: {{ palette.primary | default('#0F172A') }}; }
    p { font-size: 15px; margin: 0 0 12px; }
    .meta { font-size: 12px; color: #6B7280; margin-bottom: 24px; }
    .section { margin-bottom: 24px; }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      background: {{ palette.accent | default('#2563EB') }};
      color: #FFFFFF !important;
      text-decoration: none;
      font-weight: 600;
      border-radius: 6px;
      font-size: 15px;
    }
    .footer {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid #E5E7EB;
      font-size: 12px;
      color: #6B7280;
      text-align: center;
    }
    .footer a { color: #6B7280; }
  </style>
</head>
<body>
  <div class="container">
    <div class="meta">TaskOn Newsletter · {{ send_date_str | e }}</div>

    <h1>{{ subject | e }}</h1>

    <div class="section">
      <h2>头条</h2>
      <p>{{ intro | safe }}</p>
    </div>

    <div class="section">
      <h2>案例</h2>
      <p>{{ case_study | safe }}</p>
    </div>

    <div class="section">
      <h2>本月雷达</h2>
      <p>{{ radar | safe }}</p>
    </div>

    <div class="section" style="text-align:center;margin:32px 0;">
      <p style="margin-bottom:16px">{{ cta | safe }}</p>
      <a class="btn" href="{{ cta_url | e }}">查看详情</a>
    </div>

    <div class="footer">
      <p>
        TaskOn · Web3 Growth Platform<br>
        <a href="{% raw %}{{UnsubscribeURL}}{% endraw %}">退订</a> ·
        <a href="https://taskon.xyz">taskon.xyz</a>
      </p>
    </div>
  </div>
</body>
</html>
