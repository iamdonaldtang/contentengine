# ============================================================
# TaskOn Marketing Engine · Environment Variables Template
# ============================================================
# Copy to `.env` and fill in actual values. `.env` is git-ignored.
# Production deployment overrides ENGINE_ROOT and SQLITE_PATH only.

# ---- 1 · Paths (portable: local dev vs server prod) ----
ENGINE_ROOT=D:/Taskon/marketing/engine
SQLITE_PATH=D:/Taskon/marketing/engine/runtime/state.db
# Production override example:
# ENGINE_ROOT=/opt/taskon-marketing/engine
# SQLITE_PATH=/var/lib/taskon/state.db

# ---- 2 · LLM portal (MiniMaxi primary + Anthropic Opus 4.7 fallback) ----
# Primary: MiniMaxi portal (OpenAI-compatible chat completions schema)
# The client accepts ANY of these env var names (deduplicates internally):
#   - MINIMAXI_API_KEY     | MINIMAX_API_KEY     (single key, simplest)
#   - MINIMAXI_API_KEY_1/2/3 | MINIMAX_API_KEY_1/2/3  (multi-key rotation)
# Same goes for MINIMAXI_BASE_URL vs MINIMAX_BASE_URL.
MINIMAXI_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
# Multi-key form (optional — for rate-limit failover; fill any subset):
# MINIMAXI_API_KEY_1=
# MINIMAXI_API_KEY_2=
# MINIMAXI_API_KEY_3=
MINIMAXI_DEFAULT_MODEL=MiniMax-M2.7-highspeed
# Available on basic plan (verified 2026-05-13): MiniMax-M2 / M2.1 / M2.5 / M2.7 + each `-highspeed` variant.
# `MiniMax-M1` requires a higher tier — do NOT use unless your plan supports it.
# Fallback: Anthropic native (used when MiniMaxi keys all exhausted/429/5xx)
ANTHROPIC_API_KEY=
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-7
# Retry budget
LLM_MAX_RETRIES_PER_KEY=2
LLM_REQUEST_TIMEOUT_SECONDS=60
# Suppress M2-series chain-of-thought (`<think>...</think>`) at API level.
# Leave unset to use model default (M2.7-highspeed still emits thinking).
# Set to `false` for production efficiency (saves 50-80% output tokens).
MINIMAXI_ENABLE_THINKING=false

# ---- 3 · Postiz (社媒发布数据 / 主数据源) ----
POSTIZ_BASE_URL=https://postiz.taskon.xyz
POSTIZ_API_KEY=

# ---- 4 · X Premium API v2 ($200/月已订阅) ----
X_BEARER_TOKEN=

# ---- 5 · X 账号 (Twikit fallback for KOL Watch M2) ----
TWIKIT_USERNAME=
TWIKIT_PASSWORD=
TWIKIT_EMAIL=

# ---- 6 · Google Analytics 4 ----
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=D:/Taskon/marketing/engine/runtime/ga4_credentials.json

# ---- 7 · Listmonk (Newsletter, self-hosted on VPS) ----
LISTMONK_BASE_URL=https://newsletter.taskon.xyz
LISTMONK_USERNAME=admin
LISTMONK_PASSWORD=

# ---- 8 · AWS SES (SMTP relay + bounce/complaint via SNS webhook) ----
AWS_SES_REGION=us-east-1
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASSWORD=
AWS_SNS_BOUNCE_TOPIC_ARN=
AWS_SNS_COMPLAINT_TOPIC_ARN=

# ---- 9 · TaskOn internal admin API (6 touchpoints + content_card push) ----
TASKON_ADMIN_API_BASE=https://api.taskon.xyz/admin
TASKON_ADMIN_TOKEN=

# ---- 10 · Self-hosted shlink (UTM short-link service) ----
SHLINK_BASE_URL=https://l.taskon.xyz
SHLINK_API_KEY=

# ---- 10b · MoneyPrinterTurbo (MPT · short-video generation) ----
# MPT runs on the host; engine container reaches it via host.docker.internal
# on Windows/Mac dev boxes. On Linux servers, rewire to a docker-network alias
# (e.g. http://moneyprinterturbo-api:8090) and add MPT to the same compose.
MPT_API_BASE=http://host.docker.internal:8090

# ---- 11 · Lark Webhook (P0/P1/P2 alert) ----
LARK_WEBHOOK_URL=

# ---- 12 · Runtime tuning ----
LOG_LEVEL=INFO
LOG_DIR=D:/Taskon/marketing/engine/runtime/logs
RUNTIME_DIR=D:/Taskon/marketing/engine/runtime
DRAFTS_DIR=D:/Taskon/marketing/engine/runtime/drafts
BACKUP_DIR=D:/Taskon/marketing/engine/runtime/backups
TIMEZONE=Asia/Shanghai

# ---- 13 · Feature flags ----
ENABLE_MINIMAXI=true
ENABLE_ANTHROPIC_FALLBACK=true
ENABLE_LARK_ALERTS=true
DRY_RUN=false

# ---- 13b · Twikit cookie pool (KOL Watch fallback) ----
# Multi-account JSON file (preferred for prod; rotates accounts every 30min).
TWIKIT_ACCOUNTS_PATH=
# If above empty, falls back to single-account env vars below (already defined in section 5).

# ---- 13c · Newsletter ----
# Listmonk subscriber-list id that the monthly campaign targets. Look it up
# in Listmonk admin → Lists → click the list → URL has the numeric id.
NEWSLETTER_LIST_ID=
# Default CTA URL when the newsletter draft's front-matter omits one.
NEWSLETTER_DEFAULT_CTA_URL=https://taskon.xyz/benchmark-report

# ---- 14 · Ingestion HTTP service (engine/ingestion/app.py) ----
# Public landing-signup + Listmonk + SES SNS webhook receiver.
# HTTPS terminated upstream by Cloudflare Tunnel; the container speaks plain HTTP.
INGESTION_PORT=5051
# Optional HMAC secrets — when set, the corresponding endpoint rejects
# unsigned requests with 401. Leave empty to disable enforcement (dev only).
INGESTION_HMAC_SECRET=
LISTMONK_WEBHOOK_SECRET=

# Lark custom-robot keyword filter override. Set this to whatever keyword(s)
# you configured in the Lark webhook security tab. Space-separated for multi.
# Leave unset to use built-in default 'TaskOn 告警 alert engine notification'.
LARK_KEYWORD=
