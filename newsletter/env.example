# TaskOn Newsletter Engine · 环境变量模板（v2 本地部署版）
# 复制为 .env 后填入真实值。.env 文件 git 忽略。
#
# 部署位置：Donald 桌面 Docker Desktop for Windows
# 路径约定：
#   规划+配置：D:\Taskon\marketing\engine\newsletter\
#   运行时数据：E:\AILife\listmonk\data\
#   SQLite 真相源：D:\Taskon\marketing\00_内容营销引擎\runtime\state.db

# ============================================================
# Listmonk 管理员（首次部署 install 用，后续可在 UI 改）
# ============================================================
LISTMONK_ADMIN_USERNAME=admin
LISTMONK_ADMIN_PASSWORD=<生成 ≥16 位强密码>

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_PASSWORD=<生成 ≥16 位强密码>

# ============================================================
# SMTP Relay · 阶段路径 W1-M3 = SendGrid Free / M4+ = AWS SES
# 这些在 Listmonk Admin UI > Settings > SMTP 配置（不在 config.toml）
# ============================================================

# --- W1-M3 SendGrid Free（主路径）---
# Listmonk UI 填入:
#   Host: smtp.sendgrid.net
#   Port: 587
#   Username: apikey
#   Password: <SendGrid API key>

# --- M4+ AWS SES（M3 末切换后改 Listmonk UI）---
# Host: email-smtp.us-east-1.amazonaws.com
# Port: 587

# ============================================================
# Webhook Server 配置
# ============================================================
# Listmonk 内部调用 webhook 用的共享密钥（同机器 Docker 网络也建议设）
WEBHOOK_SHARED_SECRET=<生成 ≥32 位随机字符串>

# Lark 告警 webhook
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx

# ============================================================
# 域名（Cloudflare Tunnel 配，W1 D5）
# ============================================================
DOMAIN_LISTMONK=newsletter.taskon.xyz
DOMAIN_WEBHOOK=newsletter-wh.taskon.xyz

# 本地端口（docker-compose.yml 已配，仅供参考）
# Listmonk Admin:  http://localhost:9000
# Webhook Server:  http://localhost:5050

# ============================================================
# AWS SES SNS Bounce/Complaint（M4 切换后启用）
# ============================================================
# AWS_SES_REGION=us-east-1
# AWS_SNS_BOUNCE_TOPIC_ARN=arn:aws:sns:us-east-1:xxx:taskon-ses-bounces
# AWS_SNS_COMPLAINT_TOPIC_ARN=arn:aws:sns:us-east-1:xxx:taskon-ses-complaints
